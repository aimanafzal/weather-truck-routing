# Copy to .env (or set in your host's dashboard). All are optional for local use.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated. *.onrender.com, *.railway.app and *.fly.dev are allowed by default.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
# Only if the frontend is hosted on a different origin than the API:
CORS_ALLOWED_ORIGINS=
# "live" (default) uses OSRM + Open-Meteo + Photon. "fake" = offline synthetic data for demos/tests.
PROVIDER_MODE=live
# Optional overrides
OSRM_URL=https://router.project-osrm.org
OPEN_METEO_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=
PHOTON_URL=https://photon.komoot.io
TRUCK_MAX_MPH=65
